# Project Identity
PROJECT_ID=1
# PROJECT_PATH=/root/dreampilot-projects/123_my-scheduler  # Auto-detected if not set
# BACKEND_URL is injected by env_injector.py at creation time from
# SCHEDULER_BACKEND_URL on the worker VPS. It points to the public API
# (https://api.dreamagent.cloud) so the executor's job_manager.py can reach
# /api/scheduler/* from inside the bwrap sandbox. The worker VPS IP is
# allowlisted via SCHEDULER_INTERNAL_ALLOWLIST on the backend so these
# calls bypass JWT auth.
BACKEND_URL=https://api.dreamagent.cloud

# Channel: Telegram (requires TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Channel: Discord (requires webhook URL)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Channel: Email (SMTP auto-injected, only recipient per-project)
# EMAIL_TO=recipient@gmail.com

# Channel: API (requires endpoint URL)
# API_ENDPOINT=https://example.com/webhook
