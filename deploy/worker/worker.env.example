# Dedicated Worker — environment (copy to worker.env and fill in)
# Every variable below is documented in WORKER_VPS_MIGRATION_RUNBOOK.md

# ── Master database (on the main VPS) ─────────────────────────────────────
DB_HOST=195.200.14.37
DB_PORT=5432
DB_NAME=dreampilot
DB_USER=admin
DB_PASSWORD=
USE_POSTGRES=true

# ── Worker identity (dedicated-worker registry) ───────────────────────────
# Unique per worker — the claim filter and hard isolation key off this.
# 'shared' is RESERVED for the legacy shared worker.
WORKER_NODE_ID=ent-1
EXECUTION_MODE=worker

# ── Internal API security ─────────────────────────────────────────────────
# Must match the main VPS. Worker :8003 is firewalled to the main IP; this
# shared secret protects /internal/* on top of that.
INTERNAL_API_SECRET=
# Per-worker secret (hardened fleet): generate a unique one per worker,
# register it in worker_nodes.secret via the admin API, and main will send
# THIS secret to this node. Falls back to INTERNAL_API_SECRET when unset.
WORKER_INTERNAL_SECRET=
# Converts main's X-Proxy-User-Id header into auth on :8003
TRUST_PROXY_AUTH=1

# ── AI providers (platform keys — same as the shared worker) ──────────────
ZAI_API_KEY=
OPENROUTER_API_KEY=

# ── Deployed-project DNS + SSL (worker serves project domains on 80/443) ──
# This worker's own public IP — project A-records point here.
SERVER_IP=
HOSTINGER_API_TOKEN=

# ── Public origin when main builds URLs for this worker ───────────────────
DREAMPILOT_WORKER_API_URL=http://WORKER_IP:8003

# Optional observability
# SENTRY_DSN=
