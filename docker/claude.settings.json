    "ANTHROPIC_BASE_URL": "http://host.docker.internal:7861/anthropic-compat",
    "ANTHROPIC_MODEL": "z-ai/glm-4.7-flash",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "true"
  },
  "mcpServers": {
    "zai-mcp-server": {
      "type": "stdio",
