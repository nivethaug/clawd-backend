# DreamAgent per-user workspace container image.
#
# One image, shared across all per-user containers (dreamagent-user-<id>).
# Built once on the worker VPS via scripts/build_user_image.sh.
#
# Design constraints (see docs/container_isolation.md §5 Container contract):
#   - Runs as uid 1001 (dreampilot), NO sudo, NO root capabilities.
#   - Contains ONLY what Claude + npm + pip need to edit/build user projects.
#   - Does NOT contain: docker CLI, PM2, nginx, the DreamAgent backend source.
#   - /workspace is the bind-mount target (per-user project dir).
#   - /cache is the read-only shared npm/pip cache mount.
#
# Runtime flags applied at `docker run` time (NOT in this Dockerfile):
#   --cap-drop=ALL --security-opt=no-new-privileges
#   --read-only --tmpfs /tmp
#   --memory=2g --cpus=2 --pids-limit=256
#   --network=dreamagent-net
#   -v /workspaces/user_<id>:/workspace:rw
#   -v /srv/cache:/cache:ro
#
# Build args (override via scripts/build_user_image.sh):
#   CLAUDE_CODE_VERSION  — pinned @anthropic-ai/claude-code version (default 2.1.27)
#   NODE_MAJOR           — Node major version (default 22)

FROM python:3.12-slim

ARG CLAUDE_CODE_VERSION=2.1.27
ARG NODE_MAJOR=22

# ─────────────────────────────────────────────────────────────────────
# Base packages: required for Claude CLI, npm, pip, git, build toolchain.
# - procps: provides ps/top/pgrep so operators can inspect container PIDs
#   from inside (docker exec user-N ps -eo comm). Without it, runaway
#   processes are hard to spot until the pids-limit kills Claude.
# - tini: minimal PID 1 init. CRITICAL: without tini, 'sleep infinity' is
#   PID 1 and never calls waitpid(), so when Claude's chrome-devtools-mcp
#   and node workers exit they become <defunct> zombies that accumulate
#   forever (counting against --pids-limit=512). tini reaps them properly.
# Kept minimal — every extra package is attack surface.
# ─────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        git \
        bash \
        build-essential \
        libpq-dev \
        procps \
        tini \
    && rm -rf /var/lib/apt/lists/*

# python:3.12-slim already provides python3, python, pip — no build-from-source needed.
RUN python3 --version && pip3 --version

# Pre-install common Python dependencies that bots/projects need.
# These are used by telegram/discord bot templates (requests, chardet)
# and website backends (sqlalchemy, psycopg2, pydantic, fastapi, uvicorn).
# pytest: bot templates ship unit/ test suites and the AI prompts mandate
# running them before publish — without pytest in the image the step fails.
# Installing them in the image avoids pip install failures inside the
# read-only container (tmpfs /tmp is too small for compilation).
RUN pip3 install --no-cache-dir --break-system-packages \
        requests chardet charset-normalizer \
        sqlalchemy psycopg2-binary pydantic \
        fastapi uvicorn python-dotenv python-telegram-bot discord.py \
        pytest

# ─────────────────────────────────────────────────────────────────────
# Node.js (via NodeSource — matches docs/worker_vps_setup.md §1.3).
# Required for Claude CLI (it's a Node package) and for user npm installs.
# ─────────────────────────────────────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g npm@latest pnpm@10

# ─────────────────────────────────────────────────────────────────────
# Claude CLI. Pinned to the same version as the worker host
# (docs/worker_vps_setup.md §4.1). Phase 4 will invoke this inside the
# container via `docker exec ... claude -p ...`.
# ─────────────────────────────────────────────────────────────────────
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
    && claude --version \
    && chmod -R a-w /usr/lib/node_modules/@anthropic-ai/claude-code

# ─────────────────────────────────────────────────────────────────────
# Non-root user. Matches worker's dreampilot uid/gid (1001) so bind-mounted
# files from /workspaces/user_<id> are owned by the same uid inside and
# outside the container. NO sudo, NO shadowutils — privilege escalation
# must be impossible from inside.
# ─────────────────────────────────────────────────────────────────────
RUN groupadd --system --gid 1001 dreampilot \
    && useradd --system --uid 1001 --gid 1001 --create-home \
              --shell /bin/bash dreampilot \
    && mkdir -p /workspace /cache /opt/claude-config \
    && chown -R dreampilot:dreampilot /home/dreampilot /workspace

# ─────────────────────────────────────────────────────────────────────
# Claude config templates. Baked into /opt/claude-config/ (read-only).
# The entrypoint.sh copies them into the writable /home/dreampilot tmpfs
# on every container start. This keeps the rootfs read-only (security)
# while giving Claude a writable home dir (functional requirement).
#
# Templates include:
#   - settings.json: ANTHROPIC_BASE_URL → host.docker.internal:7861 (proxy)
#   - .claude.json: hasCompletedOnboarding=true (Gotcha #8 — Claude 2.1.83
#     refuses to run without this onboarding state)
#
# NOTE: secrets (ANTHROPIC_AUTH_TOKEN, Z_AI_API_KEY) are NOT baked in here.
# They are injected at `docker run` time via -e flags from the worker's
# .env.postgres, so a leaked image contains no credentials.
# ─────────────────────────────────────────────────────────────────────
COPY docker/claude.settings.json /opt/claude-config/settings.json
COPY docker/claude.onboarding.json /opt/claude-config/.claude.json

# ─────────────────────────────────────────────────────────────────────
# Entrypoint: copies config templates to writable home, drops privileges,
# then runs the main command as dreampilot.
# ─────────────────────────────────────────────────────────────────────
COPY docker/entrypoint.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh

# ─────────────────────────────────────────────────────────────────────
# Final setup.
# ─────────────────────────────────────────────────────────────────────
ENV PATH="/usr/local/bin:/usr/bin:/usr/local/lib/node_modules/.bin:${PATH}"
ENV NPM_CONFIG_CACHE=/cache/npm
ENV PIP_CACHE_DIR=/cache/pip
ENV DISABLE_AUTOUPDATER=1
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

WORKDIR /workspace

# Healthcheck — claude --version must succeed and exit 0.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD claude --version || exit 1

# tini as PID 1 reaps zombie processes left behind by Claude's child workers
# (chrome-devtools-mcp, node esbuild workers, etc). Without it, 'sleep infinity'
# becomes PID 1 and never calls waitpid() — zombies accumulate until the
# --pids-limit kills Claude mid-edit. tini execs our entrypoint after installing
# its own signal handlers + reaper loop.
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/entrypoint.sh"]
CMD ["sleep", "infinity"]
