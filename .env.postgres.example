# PostgreSQL Configuration (MASTER DATABASE)
# Copy this file to .env.postgres on the server and update with real values.
# Never commit .env.postgres.

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dreampilot
DB_USER=your_db_user
DB_PASSWORD=replace_with_a_strong_database_password

# Optional: SQLite fallback (for rollback)
# SQLLITE_DB_PATH=/root/clawd-backend/clawdbot_adapter.db

# Optional: Migration mode
# POSTGRES_MIGRATION_MODE=true  # Enable PostgreSQL mode
# SQLITE_FALLBACK=false  # Disable SQLite fallback

# ── Sentry (error monitoring + payment audit) ──────────────────────────────
# Get the DSN from Sentry -> your project -> Settings -> Client Keys (DSN).
# MUST contain the ingest host, e.g. https://<key>@o<org>.ingest.sentry.io/<project>
# Without a valid DSN, Sentry stays disabled and PAYMENT_AUDIT lines read
# sentry=off. start-backend.sh sources this file, so SENTRY_DSN set here is
# exported to the backend on every restart (durable, survives plain pm2 restart).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=v1.0.0   # optional, for release tracking

# ── Worker VPS file proxy (Option B) ───────────────────────────────────────
# Set ONLY on the MAIN VPS when projects are hosted on a separate worker VPS.
# When set, the backend transparently proxies project-scoped requests
# (download ZIP, github-export, logs, build/publish, files, commits, ...) to
# the worker's internal API, where the project files actually live.
# Leave unset for single-VPS deployments (the proxy is a no-op).
#
# Format: http://<WORKER_IP>:8003
# The worker must run start-worker-api.sh and port 8003 must be firewalled to
# this VPS's IP only. See docs/worker_file_proxy.md.
WORKER_VPS_URL=

