# Groq Configuration
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama3-70b-8192

# GLM / Z.ai Configuration
Z_AI_API_KEY=your_key_here
Z_AI_API_BASE=https://api.z.ai/api/coding/paas/v4

# OpenRouter / Prompt Assistant Configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PROMPT_ASSISTANT_MODEL=z-ai/glm-4.7-flash
PROMPT_ASSISTANT_PROVIDER=balanced
# PROMPT_ASSISTANT_PROVIDER_ORDER=deepinfra
CHAT_IMAGE_VISION_MODEL=mistralai/mistral-small-3.2-24b-instruct
CHAT_IMAGE_VISION_FALLBACK_MODEL=openrouter/free
CHAT_IMAGE_VISION_MAX_TOKENS=450
CHAT_IMAGE_GLM_FALLBACK_ENABLED=true
CHAT_IMAGE_GLM_MODEL=glm-4.6v-flash
CHAT_IMAGE_GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Hostinger DNS API (for automatic DNS record creation)
HOSTINGER_API_TOKEN=your_token_here

# Hostinger DNS API (for automatic DNS record creation)
# Get token from: hPanel → Profile → API → Generate new token
HOSTINGER_API_TOKEN=your_token_here

# Google OAuth (for "Login with Google")
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
